# Required for real AI. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Any Gemini model your key can use (vision-capable). Change if your hackathon credits use a different one.
GEMINI_MODEL=gemini-3.8-flash

# Optional: ElevenLabs — the pre-event voice chat + spoken openers (otherwise browser speech)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=cgSgspJ2msm6clMCkdW9  # Jessica
# Voice intro agent ("Talk to Wingman"). Run `npm run voice:setup` once to create it and fill this in.
ELEVENLABS_AGENT_ID=

# Optional but recommended: Reddit blocks anonymous requests.
# Create a "script" app at https://www.reddit.com/prefs/apps (redirect uri: http://localhost:8787)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=wingman-hackathon/0.1 (by u/your_reddit_username)

PORT=8787
# MOCK_AI=1 skips Gemini/ElevenLabs and uses canned output (no keys needed)
MOCK_AI=

# Demo safety net: timeouts on AI calls, cache of last good results, fallbacks, always match the pair
DEMO_MODE=1
# Rehearse failures: profile | match | all
# DEMO_FAIL=

# Where two people meet once both said yes (one picked per match), separated by |
# MEET_SPOTS=by the bar|next to the big screen|by the entrance
