# Required for real AI. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Any Gemini model your key can use (vision-capable). Change if your hackathon credits use a different one.
GEMINI_MODEL=gemini-2.5-flash

# Optional: real voice for openers (otherwise the phone uses browser speech)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8Ikt8R

# Optional but recommended: Reddit blocks anonymous requests.
# Create a "script" app at https://www.reddit.com/prefs/apps (redirect uri: http://localhost:8787)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=wingman-hackathon/0.1 (by u/your_reddit_username)

PORT=8787
# MOCK_AI=1 skips Gemini/ElevenLabs and uses canned output (no keys needed)
MOCK_AI=
