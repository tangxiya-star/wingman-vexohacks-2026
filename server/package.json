{
  "name": "wingman-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/index.mjs",
    "start": "node --env-file-if-exists=.env src/index.mjs",
    "try:letterboxd": "node --env-file-if-exists=.env src/sources/letterboxd.mjs",
    "try:reddit": "node --env-file-if-exists=.env src/sources/reddit.mjs",
    "try:profile": "node --env-file-if-exists=.env src/tryProfile.mjs",
    "studio": "mastra dev --dir src/mastra",
    "voice:setup": "node --env-file-if-exists=.env src/voice/setup.mjs"
  },
  "dependencies": {
    "@mastra/core": "^1.83.0",
    "fast-xml-parser": "^4.5.0",
    "ws": "^8.18.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "mastra": "^1.39.0"
  }
}